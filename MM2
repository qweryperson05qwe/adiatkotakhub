-- ===================== ЛОГИКА =====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Radius = Settings.FOVRadius
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(255, 255, 255)

local dummyModel = nil

-- Кэш "был ли игрок шерифом" — для детекта Героя
local wasSheriff = {}

-- ---------- РОЛИ ----------
local function scanTools(container)
    if not container then return nil end
    for _, t in ipairs(container:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("murder") then
                return "Murderer"
            end
            if n == "gun" or n:find("revolver") or n:find("sheriff") then
                return "Sheriff"
            end
        end
    end
    return nil
end

local function getRole(p)
    if not p then return "Innocent" end
    local char = p.Character
    local bp = p:FindFirstChild("Backpack")

    local role = scanTools(char) or scanTools(bp)

    if role == "Sheriff" then
        -- Запоминаем, что игрок был шерифом
        wasSheriff[p] = true
        return "Sheriff"
    end

    if role == "Murderer" then
        return "Murderer"
    end

    -- Пистолета нет, но игрок был шерифом → Герой
    if wasSheriff[p] and p ~= LocalPlayer then
        return "Hero"
    end

    -- Проверка атрибута (если форк MM2 отдаёт)
    if p:GetAttribute("MM2Role") == "Hero" then
        return "Hero"
    end

    return "Innocent"
end

local function getSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Sheriff"
           and p.Character and p.Character:FindFirstChild("Head") then
            return p
        end
    end
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Murderer"
           and p.Character and p.Character:FindFirstChild("Head") then
            return p
        end
    end
end

local function getClosestPlayer()
    local closest, minDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Head") then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and getRole(p) ~= "Murderer" then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (myChar.Head.Position - head.Position).Magnitude
                if dist < minDist then minDist = dist; closest = p end
            end
        end
    end
    return closest
end

-- ---------- ESP ----------
local function ensureHighlight(char)
    if not char then return nil end
    local hl = char:FindFirstChild("MM2_Role_Highlight")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "MM2_Role_Highlight"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.OutlineTransparency = 0
        hl.FillTransparency = 0.5
        hl.Parent = char
    end
    return hl
end

local function applyRoleColor(hl, role)
    if role == "Murderer" then
        hl.FillColor = Color3.fromRGB(255, 30, 30)
        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then
        hl.FillColor = Color3.fromRGB(30, 120, 255)
        hl.OutlineColor = Color3.fromRGB(0, 80, 255)
    elseif role == "Hero" then
        hl.FillColor = Color3.fromRGB(255, 220, 30)   -- жёлтый
        hl.OutlineColor = Color3.fromRGB(255, 200, 0)
    else
        hl.FillColor = Color3.fromRGB(30, 230, 80)
        hl.OutlineColor = Color3.fromRGB(0, 200, 60)
    end
end

-- Хук на респавн — сбрасываем Highlight
local function hookChar(p)
    p.CharacterAdded:Connect(function(char)
        local old = char:FindFirstChild("MM2_Role_Highlight")
        if old then old:Destroy() end
    end)
end
for _, p in ipairs(Players:GetPlayers()) do hookChar(p) end
Players.PlayerAdded:Connect(hookChar)

-- ---------- АВТОПОДБОР: состояние ----------
local pickupState = {
    active = false,        -- сейчас летим за пистолетом
    originalCFrame = nil,  -- куда вернуться
    dropTool = nil,        -- за каким Tool летим
}

local function findGunDrop()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and (obj.Name == "GunDrop" or obj.Name:lower():find("gun")) then
            local h = obj:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then
                return obj, h
            end
        end
    end
    return nil
end

local function hasGun()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function scan(c)
        if not c then return false end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n == "gun" or n:find("revolver") or n:find("sheriff") then
                    return true
                end
            end
        end
        return false
    end
    return scan(char) or scan(bp)
end

-- ---------- GOD MODE / NOCLIP ----------
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hum = char:FindFirstChildOfClass("Humanoid")

        if Settings.GodMode then
            if hum then hum.Health = hum.MaxHealth end
            if not dummyModel and char.Archivable then
                char.Archivable = true
                local ok, clone = pcall(function() return char:Clone() end)
                if ok and clone then
                    dummyModel = clone
                    dummyModel.Parent = Workspace
                    for _, v in ipairs(dummyModel:GetDescendants()) do
                        if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
                    end
                end
            end
        else
            if dummyModel then
                dummyModel:Destroy()
                dummyModel = nil
            end
        end

        if Settings.NoClip then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end)

-- ---------- ФЛИНГ (в отдельном потоке) ----------
task.spawn(function()
    while task.wait(0.1) do
        if Settings.FlingMurder or Settings.FlingSheriff then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local target = nil
                if Settings.FlingMurder then target = getMurderer() end
                if not target and Settings.FlingSheriff then target = getSheriff() end
                local tHRP = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                if tHRP then
                    hrp.CFrame = tHRP.CFrame
                    hrp.AssemblyLinearVelocity = Vector3.new(30000, 30000, 30000)
                    hrp.AssemblyAngularVelocity = Vector3.new(30000, 30000, 30000)
                end
            end
        end
    end
end)

-- ---------- ВСПОМОГАТЕЛЬНАЯ: поиск Tool ----------
local function findTool(keyword)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function scan(c)
        if not c then return nil end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find(keyword) then return t end
            end
        end
        return nil
    end
    return scan(char) or scan(bp)
end

-- ---------- ОСНОВНОЙ ЦИКЛ ----------
local lastAction = 0

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Settings.ShowFOV
    FOVCircle.Radius = Settings.FOVRadius
    if Settings.ShowFOV then FOVCircle.Position = Camera.ViewportSize / 2 end

    local myRole = getRole(LocalPlayer)
    local char = LocalPlayer.Character

    -- 1. Авто-выстрел Шерифа
    if myRole == "Sheriff" and char then
        local murd = getMurderer()
        if murd and murd.Character and murd.Character:FindFirstChild("Head") then
            local targetHead = murd.Character.Head
            if Settings.SheriffAim then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end

            if Settings.AutoShoot and (tick() - lastAction > 0.3) then
                local tool = findTool("gun") or findTool("revolver")
                if tool then
                    tool.Parent = char
                    pcall(function() tool:Activate() end)
                    lastAction = tick()
                end
            end
        end
    end

    -- 2. Авто-бросок Убийцы
    if myRole == "Murderer" and char then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            if Settings.MurderThrowAim then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end

            if Settings.AutoThrow and (tick() - lastAction > 0.4) then
                local tool = findTool("knife") or findTool("blade")
                if tool then
                    tool.Parent = char
                    pcall(function() tool:Activate() end)
                    lastAction = tick()
                end
            end
        end
    end

    -- 3. Отрисовка Role ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = ensureHighlight(p.Character)
            if hl then
                hl.Enabled = Settings.ESP
                if Settings.ESP then
                    applyRoleColor(hl, getRole(p))
                end
            end
        end
    end

    -- 4. Автоподбор пистолета (телепорт → возврат)
    if Settings.AutoPickup and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart

        if pickupState.active then
            -- Пистолет получен или дроп исчез → возврат
            local dropGone = not pickupState.dropTool
                or not pickupState.dropTool.Parent
            if hasGun() or dropGone then
                if pickupState.originalCFrame then
                    hrp.CFrame = pickupState.originalCFrame
                end
                pickupState.active = false
                pickupState.originalCFrame = nil
                pickupState.dropTool = nil
            else
                -- Всё ещё летим к дропу
                local h = pickupState.dropTool:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    hrp.CFrame = h.CFrame + Vector3.new(0, 2, 0)
                else
                    if pickupState.originalCFrame then
                        hrp.CFrame = pickupState.originalCFrame
                    end
                    pickupState.active = false
                    pickupState.originalCFrame = nil
                    pickupState.dropTool = nil
                end
            end
        else
            -- Ищем дроп и стартуем
            local tool, handle = findGunDrop()
            if tool and handle then
                pickupState.active = true
                pickupState.originalCFrame = hrp.CFrame
                pickupState.dropTool = tool
                hrp.CFrame = handle.CFrame + Vector3.new(0, 2, 0)
            end
        end
    else
        -- Автоподбор выключен — сбросить состояние
        if pickupState.active then
            pickupState.active = false
            pickupState.originalCFrame = nil
            pickupState.dropTool = nil
        end
    end
end)

pcall(function()
    Slate:Notify({
        Title = "adiatkotak hub",
        Description = "ESP ролей + Hero + Автоподбор загружены!",
        Icon = "check-circle",
        Duration = 5,
    })
end)