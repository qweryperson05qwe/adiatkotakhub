SecSkins:Button({
    Name = "Выдать Corrupt & Harvester",
    Icon = "package-plus",
    Callback = function()
        local bp = game.Players.LocalPlayer:FindFirstChild("Backpack")
        local weapons = game:GetService("ReplicatedStorage"):FindFirstChild("Weapons") or game:GetService("ReplicatedStorage")
        if bp then
            for _, name in ipairs({"Corrupt", "Harvester"}) do
                if not bp:FindFirstChild(name) then
                    local found = nil
                    for _, item in ipairs(weapons:GetDescendants()) do
                        if item.Name == name and item:IsA("Tool") then
                            found = item:Clone()
                            break
                        end
                    end
                    if found then
                        found.Parent = bp
                    else
                        local t = Instance.new("Tool")
                        t.Name = name
                        local h = Instance.new("Part", t)
                        h.Name = "Handle"
                        h.Size = Vector3.new(1, 0.8, 3)
                        t.Parent = bp
                    end
                end
            end
            pcall(function() Slate:Notify({ Title = "adiatkotak hub", Description = "Скины добавлены!", Icon = "check", Duration = 3 }) end)
        end
    end,
})

