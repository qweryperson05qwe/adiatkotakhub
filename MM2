local wasSheriff = {}

local function scanTools(container)
    if not container then return nil end
    for _, t in ipairs(container:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("murder") then return "Murderer" end
            if n:find("gun") or n:find("revolver") or n:find("sheriff") or n == "colt" or n == "classic" then return "Sheriff" end
        end
    end
    return nil
end

local function getRole(p)
    if not p then return "Innocent" end
    local char = p.Character
    local bp = p:FindFirstChild("Backpack")
    local role = scanTools(char) or scanTools(bp)
    if role == "Sheriff" then wasSheriff[p] = true; return "Sheriff" end
    if role == "Murderer" then return "Murderer" end
    local attr = p:GetAttribute("Role") or p:GetAttribute("MM2Role")
    if attr == "Murderer" then return "Murderer" end
    if attr == "Sheriff" then wasSheriff[p] = true; return "Sheriff" end
    if attr == "Hero" then return "Hero" end
    if wasSheriff[p] and p ~= LocalPlayer then return "Hero" end
    return "Innocent"
end

local function getSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Sheriff" and p.Character and p.Character:FindFirstChild("Head") then return p end
    end
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Murderer" and p.Character and p.Character:FindFirstChild("Head") then return p end
    end
end

local function getClosestPlayer()
    local closest, minDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Head") then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and getRole(p) ~= "Murderer" then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (myChar.Head.Position - head.Position).Magnitude
                if dist < minDist then minDist = dist; closest = p end
            end
        end
    end
    return closest
end

local function ensureHighlight(char)
