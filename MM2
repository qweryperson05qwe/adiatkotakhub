local lastShoot = 0
local lastThrow = 0

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Settings.ShowFOV
    FOVCircle.Radius = Settings.FOVRadius
    if Settings.ShowFOV then FOVCircle.Position = Camera.ViewportSize / 2 end

    local myRole = getRole(LocalPlayer)
    local char = LocalPlayer.Character

    if myRole == "Sheriff" and char then
        local murd = getMurderer()
        if murd and murd.Character and murd.Character:FindFirstChild("Head") then
            local targetHead = murd.Character.Head
            if Settings.SheriffAim then
                pcall(function()
                    Camera.CameraType = Enum.CameraType.Scriptable
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
                end)
            end
            if Settings.AutoShoot and (tick() - lastShoot > 0.35) then
                local tool = findTool("gun") or findTool("revolver") or findTool("colt")
                if tool then
                    tool.Parent = char
                    pcall(function() tool:Activate() end)
                    lastShoot = tick()
                end
            end
        end
    end

    if myRole == "Murderer" and char then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            if Settings.MurderThrowAim then
                pcall(function()
                    Camera.CameraType = Enum.CameraType.Scriptable
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
                end)
            end
            if Settings.AutoThrow and (tick() - lastThrow > 0.4) then
                local tool = findTool("knife") or findTool("blade")
                if tool then
                    tool.Parent = char
                    pcall(function() tool:Activate() end)
                    lastThrow = tick()
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = ensureHighlight(p.Character)
            if hl then
                hl.Enabled = Settings.ESP
                if Settings.ESP then
                    local role = getRole(p) or "Innocent"
                    applyRoleColor(hl, role)
                end
            end
        end
    end

    local traceIndex = 1
    if Settings.Tracer then
        local from = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen and screenPos.Z > 0 then
                        local line = TracerLines[traceIndex]
                        if line then
                            line.Visible = true
                            line.Thickness = Settings.TracerThickness
                            line.From = from
                            line.To = Vector2.new(screenPos.X, screenPos.Y)
                            local role = getRole(p)
                            if role == "Murderer" then line.Color = Color3.fromRGB(255, 40, 40)
                            elseif role == "Sheriff" then line.Color = Color3.fromRGB(40, 120, 255)
                            elseif role == "Hero" then line.Color = Color3.fromRGB(255, 220, 40)
                            else line.Color = Color3.fromRGB(40, 230, 80) end
                            traceIndex = traceIndex + 1
                        end
                    end
                end
            end
        end
    end
    for i = traceIndex, #TracerLines do TracerLines[i].Visible = false end

    if Settings.AutoPickup and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        if pickupState.active then
            local dropGone = not pickupState.dropTool or not pickupState.dropTool.Parent
            if hasGun() or dropGone then
                if pickupState.originalCFrame then hrp.CFrame = pickupState.originalCFrame end
                pickupState.active = false
                pickupState.originalCFrame = nil
                pickupState.dropTool = nil
            else
                local h = pickupState.dropTool:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    hrp.CFrame = h.CFrame + Vector3.new(0, 2, 0)
                else
                    if pickupState.originalCFrame then hrp.CFrame = pickupState.originalCFrame end
                    pickupState.active = false
                    pickupState.originalCFrame = nil
                    pickupState.dropTool = nil
                end
            end
        else
            local tool, handle = findGunDrop()
            if tool and handle then
                pickupState.active = true
                pickupState.originalCFrame = hrp.CFrame
                pickupState.dropTool = tool
                hrp.CFrame = handle.CFrame + Vector3.new(0, 2, 0)
            end
        end
    else
        if pickupState.active then
            pickupState.active = false
            pickupState.originalCFrame = nil
            pickupState.dropTool = nil
        end
    end
end)

