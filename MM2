local flyState = { active = false, bg = nil, bv = nil, conn = nil }

local function stopFly()
    if flyState.bg then flyState.bg:Destroy(); flyState.bg = nil end
    if flyState.bv then flyState.bv:Destroy(); flyState.bv = nil end
    if flyState.conn then flyState.conn:Disconnect(); flyState.conn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    flyState.active = false
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    stopFly()
    local bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = root.CFrame
    bg.Parent = root
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(0, 0.1, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = root
    hum.PlatformStand = true
    flyState.bg = bg
    flyState.bv = bv
    flyState.active = true
    flyState.conn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        if not c or not flyState.active then return end
        local r = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 then stopFly(); return end
        local camera = workspace.CurrentCamera
        local md = h.MoveDirection
        if md.Magnitude > 0 then
            local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
            local flatRight = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z).Unit
            bv.Velocity = (flatLook * md.Z + flatRight * md.X) * Settings.FlySpeed
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        bg.CFrame = camera.CFrame
    end)
end

task.spawn(function()
    while task.wait(0.2) do
        if Settings.Fly and not flyState.active then startFly()
        elseif not Settings.Fly and flyState.active then stopFly() end
    end
end)

local flingState = { cooldown = 0 }

local function doFlingOnce(targetPlayer)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tChar = targetPlayer and targetPlayer.Character
    local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local originalCFrame = hrp.CFrame
    hrp.CFrame = tHRP.CFrame
    task.wait(0.05)
    pcall(function()
        tHRP.AssemblyLinearVelocity = Vector3.new(0, 50000, 0)
        tHRP.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)
    end)
    task.wait(0.05)
    if originalCFrame then hrp.CFrame = originalCFrame end
end

task.spawn(function()
    while task.wait(0.1) do
        if (Settings.FlingMurder or Settings.FlingSheriff) and tick() > flingState.cooldown then
            local target = nil
            if Settings.FlingMurder then target = getMurderer() end
            if not target and Settings.FlingSheriff then target = getSheriff() end
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                doFlingOnce(target)
                flingState.cooldown = tick() + 0.5
            end
        end
    end
end)

local statusStart = tick()
local fpsSamples = {}
local lastFrameTime = tick()

local function getFPS()
    local now = tick()
    table.insert(fpsSamples, now - lastFrameTime)
    lastFrameTime = now
    if #fpsSamples > 30 then table.remove(fpsSamples, 1) end
    local sum = 0
    for _, v in ipairs(fpsSamples) do sum = sum + v end
    local avg = sum / math.max(#fpsSamples, 1)
    return math.floor(1 / math.max(avg, 0.001))
end

