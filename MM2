-- ИГРОВАЯ ЛОГИКА И ИСПРАВЛЕНИЯ
---------------------------------------------------------
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Radius = Settings.FOVRadius
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(255, 255, 255)

local dummyModel = nil

local function getRole(p)
    if not p or not p.Character then return "Innocent" end
    local char, bp = p.Character, p:FindFirstChild("Backpack")
    local function check(c)
        if not c then return nil end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("murderer") or n:find("blade") then return "Murderer"
                elseif n:find("gun") or n:find("revolver") or n:find("sheriff") then return "Sheriff" end
            end
        end
    end
    return check(char) or check(bp) or "Innocent"
end

local function getSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Sheriff" and p.Character and p.Character:FindFirstChild("Head") then return p end
    end
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == "Murderer" and p.Character and p.Character:FindFirstChild("Head") then return p end
    end
end

local function getClosestPlayer()
    local closest, minDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Head") then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and getRole(p) ~= "Murderer" then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (myChar.Head.Position - head.Position).Magnitude
                if dist < minDist then minDist = dist; closest = p end
            end
        end
    end
    return closest
end

-- Логика God Mode и Флинга
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")

        if Settings.GodMode then
            if hum then hum.Health = hum.MaxHealth end
            -- Клонирование пустышки для визуального обмана
            if not dummyModel and char.Archivable then
                char.Archivable = true
                dummyModel = char:Clone()
                dummyModel.Parent = Workspace
                for _, v in ipairs(dummyModel:GetDescendants()) do
                    if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
                end
            end
        else
            if dummyModel then
                dummyModel:Destroy()
                dummyModel = nil
            end
        end

        if Settings.NoClip then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        -- Флинг
        local targetP = Settings.FlingMurder and getMurderer() or (Settings.FlingSheriff and getSheriff() or nil)
        if targetP and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") and hrp then
            hrp.CFrame = targetP.Character.HumanoidRootPart.CFrame
            hrp.AssemblyLinearVelocity = Vector3.new(30000, 30000, 30000)
            hrp.AssemblyAngularVelocity = Vector3.new(30000, 30000, 30000)
        end
    end
end)

local lastAction = 0

-- Авто-выстрел и Авто-бросок в RenderStepped
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Settings.ShowFOV
    FOVCircle.Radius = Settings.FOVRadius
    if Settings.ShowFOV then FOVCircle.Position = Camera.ViewportSize / 2 end

    local myRole = getRole(LocalPlayer)
    local char = LocalPlayer.Character

    -- 1. Исправленный Авто-выстрел Шерифа
    if myRole == "Sheriff" and char then
        local murd = getMurderer()
        if murd and murd.Character and murd.Character:FindFirstChild("Head") then
            local targetHead = murd.Character.Head
            if Settings.SheriffAim then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end
            
            if Settings.AutoShoot and (tick() - lastAction > 0.3) then
                local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if tool then
                    tool.Parent = char -- Авто-взятие в руки
                    tool:Activate() -- Прямая активация
                    lastAction = tick()
                end
            end
        end
    end

    -- 2. Исправленный Авто-бросок Убийцы
    if myRole == "Murderer" and char then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            if Settings.MurderThrowAim then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end
            
            if Settings.AutoThrow and (tick() - lastAction > 0.4) then
                local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if tool then
                    tool.Parent = char
                    tool:Activate()
                    lastAction = tick()
                end
            end
        end
    end

    -- Отрисовка Role ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("MM2_Role_Highlight")
            if hl then
                hl.Enabled = Settings.ESP
                if Settings.ESP then
                    local role = getRole(p)
                    if role == "Murderer" then hl.FillColor = Color3.fromRGB(255, 30, 30)
                    elseif role == "Sheriff" then hl.FillColor = Color3.fromRGB(30, 120, 255)
                    else hl.FillColor = Color3.fromRGB(30, 230, 80) end
                end
            end
        end
    end

    -- Автоподбор пистолета
    if Settings.AutoPickup and char and char:FindFirstChild("HumanoidRootPart") then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "GunDrop" or (obj:IsA("Tool") and obj.Name:lower():find("gun")) then
                local h = obj:FindFirstChild("Handle") or obj
                if h and h:IsA("BasePart") then
                    char.HumanoidRootPart.CFrame = h.CFrame + Vector3.new(0, 2, 0)
                end
            end
        end
    end
end)

pcall(function()
    Slate:Notify({
        Title = "adiatkotak hub",
        Description = "Бой и God Mode обновлены!",
        Icon = "check-circle",
        Duration = 5,
    })
end)
