local function formatUptime(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function trySetDesc(label, text)
    if not label then return end
    pcall(function()
        if label.SetDesc then label:SetDesc(text)
        elseif label.SetDescription then label:SetDescription(text)
        elseif label.SetText then label:SetText(text)
        end
    end)
end

