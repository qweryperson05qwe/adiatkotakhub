local function hasGun()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function scan(c)
        if not c then return false end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("gun") or n:find("revolver") or n == "colt" then return true end
            end
        end
        return false
    end
    return scan(char) or scan(bp)
end

local function findTool(keyword)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function scan(c)
        if not c then return nil end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find(keyword) then return t end
        end
        return nil
    end
    return scan(char) or scan(bp)
end

local godState = { ghostHighlight = nil, dummyModel = nil, hpConn = nil, diedConn = nil }

local function installHpLock(char)
    if godState.hpConn then godState.hpConn:Disconnect() end
    if godState.diedConn then godState.diedConn:Disconnect() end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    godState.hpConn = hum.HealthChanged:Connect(function(newHP)
        if Settings.GodMode and newHP < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
    godState.diedConn = hum.Died:Connect(function()
        if Settings.GodMode and char and char.Parent then
            task.wait(0.1)
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then h.Health = h.MaxHealth end
        end
    end)
end

local function makeGhost(char)
    if not godState.ghostHighlight or godState.ghostHighlight.Parent ~= char then
        if godState.ghostHighlight then godState.ghostHighlight:Destroy() end
        godState.ghostHighlight = Instance.new("Highlight")
        godState.ghostHighlight.Name = "MM2_Ghost_Highlight"
        godState.ghostHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        godState.ghostHighlight.FillColor = Color3.fromRGB(120, 200, 255)
        godState.ghostHighlight.OutlineColor = Color3.fromRGB(80, 160, 255)
        godState.ghostHighlight.FillTransparency = 0.7
        godState.ghostHighlight.OutlineTransparency = 0.3
        godState.ghostHighlight.Parent = char
    end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Decal") then v.LocalTransparencyModifier = 0.7 end
    end
end

local function clearGhost(char)
    if godState.ghostHighlight then godState.ghostHighlight:Destroy(); godState.ghostHighlight = nil end
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then v.LocalTransparencyModifier = 0 end
        end
    end
end

local function spawnDummy(char)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if godState.dummyModel then return end
    char.Archivable = true
    local ok, clone = pcall(function() return char:Clone() end)
    if not ok or not clone then return end
    godState.dummyModel = clone
    godState.dummyModel.Name = "MM2_FakeBody"
    godState.dummyModel.Parent = Workspace
    for _, v in ipairs(godState.dummyModel:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy()
        elseif v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false end
    end
    local h = godState.dummyModel:FindFirstChildOfClass("Humanoid")
    if h then h:Destroy() end
end

local function removeDummy()
    if godState.dummyModel then godState.dummyModel:Destroy(); godState.dummyModel = nil end
end
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if Settings.GodMode then
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
